# Clerk — get from dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY
CLERK_SECRET_KEY=sk_test_YOUR_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/home
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/home

# Supabase — get from supabase.com → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk Billing Plan IDs — Clerk Dashboard → Billing → Plans → copy Plan ID
NEXT_PUBLIC_CLERK_FAN_PLAN_ID=cplan_YOUR_FAN_PLAN_ID
NEXT_PUBLIC_CLERK_PRO_PLAN_ID=cplan_YOUR_PRO_PLAN_ID

# Pirate Weather — sign up at https://pirate-weather.apiable.io/
PIRATEWEATHER_API_KEY=your_key_here
